<Item class="ReplicatedStorage" referent="RBX7"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX6"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	Config
	Every tunable number, colour, name and asset id for Bobux Obby lives here.
	Server and client both read this module, so changing a value in one place
	changes it everywhere.
]]

local Config = {}

local RGB = Color3.fromRGB

Config.GameName = "BOBUX OBBY"
Config.Tagline = "30 stages. 5 worlds. One epic climb."
Config.DataStoreName = "BobuxObby_v1"

----------------------------------------------------------------------
-- Movement
----------------------------------------------------------------------
